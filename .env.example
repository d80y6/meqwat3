# Meqwat SaaS — environment configuration (copy to .env)

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# JWT signing secret for session tokens (REQUIRED in production — server refuses to start without it).
# Generate: openssl rand -hex 32  (must be ≥32 chars)
# In development, if unset, a per-deployment derived secret is used with a warning (see src/lib/auth.ts).
# Production deployments MUST set this explicitly (Render generates it via generateValue: true).
AUTH_SECRET=

# First platform administrator (used once by `npx tsx src/db/bootstrap.ts`)
ADMIN_EMAIL=admin@meqwat.app
ADMIN_PASSWORD=
ADMIN_NAME=مدير المنصة

# Runtime production DATABASE_URL must use restricted role meqwat_app, not schema owner.
# Exact public HTTPS origin, also used for trusted password recovery links:
APP_ORIGIN=
# Optional SMTP for credential/recovery email (no secrets printed by mailer):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Sandbox preview/demo hints are OFF in production:
ARENA_PREVIEW=0
NEXT_PUBLIC_SHOW_DEMO=false
