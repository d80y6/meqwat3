# Meqwat SaaS — environment configuration (copy to .env)

# PostgreSQL connection string (required).
# Production: use the restricted `meqwat_app` role so RLS policies bind
# (created by db/init/01-app-role.sql in Docker, or manually — see db/rls.sql).
DATABASE_URL=postgresql://meqwat_app:change-me@127.0.0.1:5432/app_db

# Privileged connection used ONLY for migrations (drizzle-kit push).
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Docker compose: password for the meqwat_app role
APP_DB_PASSWORD=

# SMTP for owner-credential delivery (optional; without it, credentials are
# handed over manually by the platform admin — the app never fakes delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=منصة مقوات <no-reply@meqwat.app>

# JWT signing secret for session tokens (required in production).
# Generate: openssl rand -hex 32
# If unset, a secret is derived from DATABASE_URL as a fallback — acceptable
# for local/dev, NOT recommended for production.
AUTH_SECRET=

# First platform administrator (used once by `npx tsx src/db/bootstrap.ts`)
ADMIN_EMAIL=admin@meqwat.app
ADMIN_PASSWORD=
ADMIN_NAME=مدير المنصة
