# Meqwat SaaS — environment configuration (copy to .env)

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# JWT signing secret for session tokens (required in production).
# Generate: openssl rand -hex 32
# If unset, a secret is derived from DATABASE_URL as a fallback — acceptable
# for local/dev, NOT recommended for production.
AUTH_SECRET=

# First platform administrator (used once by `npx tsx src/db/bootstrap.ts`)
ADMIN_EMAIL=admin@meqwat.app
ADMIN_PASSWORD=
ADMIN_NAME=مدير المنصة
